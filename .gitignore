# Local secrets (e.g. the aisstream.io key used by ais_relay.py)
.env

# Local copy of the buoys ERDDAP data (SQLite, see erddap_mirror.py)
erddap_mirror.sqlite*

# The buoy's AIS history (SQLite, see tools/buoy_ais.py)
ais_history.sqlite*

# psycopg for local development, installed with Docker (see deploy/README.md)
.pylib/
