# Copy to .env (not in git) and fill in. Read by boia_server.py
# aisstream.io key, for the AIS ships (free: https://aisstream.io)
AISSTREAM_API_KEY=
# Websites allowed to use the server (comma separated), e.g. the published app
BOIA_ORIGINS=https://sio-icm.github.io
# Phones sending a boat's position (Traccar Client device id:name shown), comma separated
PATI_DEVICES=
# Accept the simulated patí of tools/simulate_pati.py (1 to accept). Only for testing, never on a public server
PATI_SIMULATOR=
# Where the proxy and patí port listens: empty for every interface (to test with a phone on the
# same network), 127.0.0.1 on a server behind nginx
BOIA_HTTP_HOST=
# The BlueLab's (ICM) public fleet tracker, for its autonomous vehicles (BlueBoats); empty, off
FLEET_URL=https://bluelab-workstation.tailb3d561.ts.net
# Only vehicles seen in the last hours (default 6), and never those whose id starts with these (default sim-)
FLEET_MAX_HOURS=
FLEET_EXCLUDE=
# Names shown for the vehicles (device id:name), comma separated; by default "BlueBoat <id>"
FLEET_NAMES=
# Simulated boats always sailing near the buoy, marked as simulated: blueboat, pati (comma
# separated), or 1 for both
SIMULATED_BOATS=
